          "name": "06 - A player joins (201 Created)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Player joining returns 201 Created\", function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "function findValue(obj, keys) {",
                  "  if (!obj || typeof obj !== \"object\") return undefined;",
                  "  for (const key of keys) if (obj[key] !== undefined && obj[key] !== null) return obj[key];",
                  "  for (const key of [\"data\", \"session\", \"player\", \"result\"]) {",
                  "    if (obj[key] && typeof obj[key] === \"object\") {",
                  "      const found = findValue(obj[key], keys);",
                  "      if (found !== undefined) return found;",
                  "    }",
                  "  }",
                  "  return undefined;",
                  "}",
                  "const playerId = findValue(body, [\"playerId\", \"player_id\"]);",
                  "pm.test(\"Response contains a player ID\", function () { pm.expect(playerId).to.not.equal(undefined); });",
                  "if (playerId !== undefined) pm.collectionVariables.set(\"player1Id\", String(playerId));",
                  "pm.test(\"First join is not marked as rejoin\", function () { pm.expect(findValue(body, [\"rejoined\"])).to.eql(false); });"
                ]
              }
            }
          ],
