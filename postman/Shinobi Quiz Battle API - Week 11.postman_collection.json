  "item": [
    {
      "name": "Module 2 - Sessions and Joining",
      "item": [
        {
          "name": "01 - A host starts a game (201 Created)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Host creating a game returns 201 Created\", function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "function findValue(obj, keys) {",
                  "  if (!obj || typeof obj !== \"object\") return undefined;",
                  "  for (const key of keys) if (obj[key] !== undefined && obj[key] !== null) return obj[key];",
                  "  for (const key of [\"data\", \"session\", \"player\", \"result\"]) {",
                  "    if (obj[key] && typeof obj[key] === \"object\") {",
                  "      const found = findValue(obj[key], keys);",
                  "      if (found !== undefined) return found;",
                  "    }",
                  "  }",
                  "  return undefined;",
                  "}",
                  "const code = findValue(body, [\"joinCode\", \"join_code\", \"sessionCode\", \"session_code\", \"code\"]);",
                  "pm.test(\"Response contains a six-digit game code\", function () { pm.expect(String(code || \"\")).to.match(/^\\d{6}$/); });",
                  "if (code) pm.collectionVariables.set(\"sessionCode\", String(code));",
                  "pm.test(\"Game starts in LOBBY\", function () {",
                  "  const status = findValue(body, [\"status\", \"sessionStatus\", \"session_status\"]);",
                  "  pm.expect(String(status || \"\").toUpperCase()).to.eql(\"LOBBY\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Demo-User",
                "value": "{{hostSchoolId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"questionSetId\": 1,\n  \"timeLimit\": 600\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "sessions"
              ]
            }
          },
          "response": []
        },
